# Variables para docker-compose.dokploy.yml (Dokploy).
# Copiar como .env en el servidor o cargar cada valor desde la UI de Dokploy.
# NUNCA versionar el .env real.

# --- Base de datos ---
# Contraseña solo alfanumérica: se inserta en DATABASE_URL sin escapar.
POSTGRES_USER=establo
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_ALFANUMERICA
POSTGRES_DB=establo_db

# --- Seguridad ---
# Generar con: openssl rand -hex 32
SECRET_KEY=CAMBIA_ESTA_CLAVE

# --- SQL Server para BI ---
# Contraseña del usuario sa del servicio `mssql`. 8+ caracteres con mayúscula,
# minúscula, número y símbolo. Evitar $ (escapar como $$) y #.
# Solo se aplica al inicializar el volumen mssql_data.
MSSQL_SA_PASSWORD=CAMBIA_ESTA_CLAVE_SA

# --- Mercado Pago (opcional) ---
MP_ACCESS_TOKEN=
# Debe ser la URL HTTPS pública del webhook, no localhost:
MP_WEBHOOK_URL=https://app.tu-dominio.com/api/v1/pagos/webhook

# --- Red ---
# Dominio público que agrega CORS además del frontend. Vacío = solo mismo origen.
ALLOWED_ORIGINS=
# Puerto del host que Dokploy/Traefik apunta al contenedor web.
WEB_PORT=3000
