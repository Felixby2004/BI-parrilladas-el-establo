# ──────────────────────────────────────────────────────
# PARRILLADAS EL ESTABLO — Variables de Entorno
# Copia este archivo como .env y completa tus valores
# ──────────────────────────────────────────────────────

# ── Entorno ─────────────────────────────────────────
ENVIRONMENT=development

# ── Base de datos (PostgreSQL via Docker) ───────────
DATABASE_URL=postgresql+asyncpg://establo_user:establo_pass@127.0.0.1:5432/establo_db

# ── Mercado Pago Sandbox ─────────────────────────────
# Obtén tu Access Token en: https://www.mercadopago.com.mx/developers/panel
MP_ACCESS_TOKEN=TEST-XXXXXXXXXXXXXXXXXXXX-XXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXXX
MP_PUBLIC_KEY=TEST-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# URL que MP usará para notificar pagos (usa ngrok en local)
MP_WEBHOOK_URL=https://TU-NGROK-URL.ngrok.io/api/v1/pagos/webhook

# ── Seguridad ────────────────────────────────────────
SECRET_KEY=cambiar_por_una_clave_segura_de_32_chars_minimo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
